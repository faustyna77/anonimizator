{
  "manifest_version": 3,
  "name": "Anonymizer Prawniczy",
  "version": "1.1",
  "description": "Lokalny pilot anonimizacji dokumentów dla http://127.0.0.1:5173/.",
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:5173/*",
    "https://anonimizator.fly.dev/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anonimizator Prawniczy"
  }
}
