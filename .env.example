# Local configuration. Do not commit real values.
APP_ENVIRONMENT=development
PANEL_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/anonimizator

# Public browser values. These may be supplied as VITE_SUPABASE_* only at frontend build time.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key

# Server-only. Never prefix this value with VITE_ and never add it to frontend config.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Document storage and mapping encryption. Server-only; never use VITE_* or commit real values.
S3_BUCKET=replace-with-document-storage-bucket
S3_REGION=replace-with-aws-region
AWS_ACCESS_KEY_ID=replace-with-s3-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
# Generate locally with: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_MAPPING_ENCRYPTION_KEY=replace-with-fernet-key
